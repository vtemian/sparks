{
  "uid": "sparks-overview",
  "title": "Sparks overview",
  "description": "Every training run ever, from the node_exporter textfile collector rather than remote-write. A .prom file is re-scraped for as long as it exists, so these rows never age out of retention the way pushed series do; the file on disk stays the source of truth even if the TSDB is lost. Queried instant at now() on purpose: this is a current-state table, and a run's history lives in the VALUE of sparks_run_start_timestamp_seconds, not in sample timestamps.",
  "tags": [
    "training",
    "sparks"
  ],
  "editable": true,
  "timezone": "browser",
  "graphTooltip": 0,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "type": "constant",
        "name": "tariff",
        "label": "Tariff per kWh",
        "description": "Currency per kWh. A variable, not a hardcoded number: it changes, and a variable means no dashboard rebuild. At these magnitudes the currency column is decoration; watt-hours per run between configs is the comparison that earns its place.",
        "query": "1.3",
        "current": {
          "text": "1.3",
          "value": "1.3"
        },
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Runs",
      "description": "Every run in the index, not just recent ones.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(sparks_run_info)",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failed",
      "description": "Anything that did not reach the end: crashed, cancelled, killed or OOM.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(sparks_run_info{status!=\"finished\"}) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total energy",
      "description": "Marginal: energy above the measured idle baseline, because the box draws power whether or not you train.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watth",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(sparks_run_marginal_energy_joules) / 3600",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total cost",
      "description": "Marginal watt-hours times the tariff. Decoration at these magnitudes; the watt-hours are the number worth reading.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(sparks_run_marginal_energy_joules) / 3600000 * $tariff",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Runs",
      "description": "One row per completed run, from instant queries joined on run_id. The join works because the info metric is valued 1, so multiplying passes the numeric value through untouched. Prometheus names every value column after its refId once there is more than one query, so the transformations below key on Value #A..#G.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Wh"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Marginal Wh"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cost"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Final loss"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "run_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open this run",
                    "url": "/d/training-runs/training-runs?var-run_id=${__data.fields[\"run_id\"]}&from=${__data.fields[\"Started\"]}&to=now",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false,
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ]
        },
        "sortBy": [
          {
            "displayName": "Started",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (run_id,user,run_name,status) (sparks_run_info)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (run_id) (sparks_run_start_timestamp_seconds) * 1000",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (run_id) (sparks_run_duration_seconds)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (run_id) (sparks_run_energy_joules) / 3600",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (run_id) (sparks_run_marginal_energy_joules) / 3600",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (run_id) (sparks_run_marginal_energy_joules) / 3600000 * $tariff",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (run_id) (sparks_run_final_loss)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "run_id",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "run_id": 0,
              "user": 1,
              "run_name": 2,
              "status": 3
            },
            "renameByName": {
              "Value #B": "Started",
              "Value #C": "Duration",
              "Value #D": "Wh",
              "Value #E": "Marginal Wh",
              "Value #F": "Cost",
              "Value #G": "Final loss"
            }
          }
        }
      ]
    }
  ]
}
